# ==============================================================================
# Ticket Management - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# The '.env' file is ignored by Git to keep your secrets private.
# ==============================================================================

# HTTP Server Port
PORT=8000

# Storage Driver ("postgres" or "memory")
DB_TYPE=postgres

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=db_name
DB_SSLMODE=disable
